# --- Local docker compose (only GEMINI_API_KEY is required) ---
GEMINI_API_KEY=

# --- Production API service (Render) ---
# DATABASE_URL=postgresql://...        # Neon direct connection string (sslmode=require)
# REDIS_URL=redis://...                # Render Key Value internal URL
# JWT_ACCESS_SECRET=                   # openssl rand -hex 32
# JWT_REFRESH_SECRET=                  # openssl rand -hex 32 (different value)
# INTERNAL_SECRET=                     # openssl rand -hex 32
# CORS_ORIGIN=https://your-app.vercel.app
# PUBLIC_API_URL=https://your-api.onrender.com
# NODE_ENV=production

# --- Frontend (Vercel) ---
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
